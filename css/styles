/* COOKO Culinary & Barista Academy — styling based on the approved desktop layout */
:root {
--cooko-red: #7b201e;
--cooko-red-dark: #651715;
--cooko-yellow: #ffdf59;
--cooko-cream: #f5edc9;
--cooko-gray: #d9d9d9;
--text: #7b201e;
--white: #fff
}
* {
box-sizing: border-box
}
html {
scroll-behavior: smooth
}
body {
margin: 0;
background: #fff;
color: var(--text);
font-family: 'Montserrat', Arial, sans-serif;
font-weight: 400
}
a {
color: inherit
}
.site-header {
height: 66px;
background: var(--cooko-red);
display: flex;
align-items: center;
padding: 0 4%;
gap: 48px;
position: relative;
z-index: 10
}
.brand {
display: flex;

align-items: center;
width: 48px;
height: 58px;
overflow: hidden
}
.brand img {
width: 100%;
height: 100%;
object-fit: contain;
object-position: center
}
.main-nav {
display: flex;
align-items: center;
gap: 58px
}
.main-nav a {
font-size: 12px;
font-weight: 700;
color: #fff;
text-decoration: none;
text-transform: uppercase;
padding: 25px 0 22px;
border-bottom: 2px solid transparent
}
.main-nav a:hover,
.main-nav a.active {
border-color: #fff
}
.menu-toggle {
display: none;
margin-left: auto;
background: none;
border: 0;
color: #fff;
font-size: 27px;
cursor: pointer
}

.hero {
height: 365px;
position: relative;
display: grid;
place-items: center;
text-align: center;
color: #fff;
background-position: center 43%;
background-size: cover
}
.hero:before {
content: '';
position: absolute;
inset: 0;
background: rgba(0, 0, 0, .38)
}
.hero-content {
position: relative;
z-index: 1;
padding: 20px
}
.hero h1 {
font-size: clamp(28px, 4vw, 42px);
line-height: 1.35;
letter-spacing: 1px;
margin: 0 0 24px;
font-weight: 600;
color: #fff
}
.hero p {
font-size: clamp(17px, 2vw, 23px);
font-weight: 700;
line-height: 1.45;
margin: 0
}
.section-title {
text-align: center;
color: var(--cooko-red);
font-size: 30px;

font-weight: 700;
margin: 52px 0 48px
}
.container {
width: min(1120px, 90%);
margin: 0 auto
}
.featured-grid {
display: grid;
grid-template-columns: repeat(2, minmax(0, 1fr));
gap: 7%;
margin: 0 auto 56px;
width: 90%
}
.program-card {
background: #d8d8d8;
border-radius: 15px;
overflow: hidden;
text-align: center;
color: var(--cooko-red);
padding-bottom: 14px
}
.program-card img {
width: 100%;
height: 230px;
object-fit: cover;
display: block;
border: 5px solid #f5eeee;
border-radius: 15px
}
.program-card h3 {
font-size: 24px;
margin: 8px 0 3px;
font-weight: 700
}
.program-card p {
font-size: 18px;
font-weight: 700;

margin: 0 8px 12px
}
.pill-button {
display: inline-block;
border: 0;
border-radius: 30px;
background: var(--cooko-red-dark);
color: #fff;
text-decoration: none;
padding: 12px 30px;
font-weight: 700;
font-size: 15px;
cursor: pointer
}
.pill-button:hover {
background: #4e1110;
color: #fff
}
.why-title {
text-align: center;
font-size: 21px;
margin: 52px 0 35px;
font-weight: 700
}
.benefits {
display: grid;
grid-template-columns: repeat(4, 1fr);
gap: 24px;
text-align: center;
margin-bottom: 60px
}
.benefit img {
height: 72px;
width: 72px;
object-fit: contain;
margin-bottom: 12px
}
.benefit h3 {

font-size: 18px;
line-height: 1.35;
margin: 0;
font-weight: 700
}
.site-footer {
background: var(--cooko-red);
color: #fff;
text-align: center;
padding: 40px 15px 32px;
margin-top: 45px
}
.footer-links {
display: flex;
justify-content: center;
gap: 30px;
margin-bottom: 18px
}
.footer-links a {
color: #fff;
font-size: 14px
}
.socials {
display: flex;
justify-content: center;
gap: 18px
}
.socials a {
color: #fff;
font-size: 24px;
text-decoration: none;
font-weight: 700
}
.page-hero {
height: 315px;
background-position: center;
background-size: cover;
display: grid;

place-items: center;
position: relative;
color: #fff
}
.page-hero:before {
content: '';
position: absolute;
inset: 0;
background: rgba(0, 0, 0, .25)
}
.page-hero h1 {
position: relative;
font-size: 36px;
font-weight: 600;
color: #fff;
margin: 0
}
.about-copy {
width: min(1080px, 86%);
margin: 36px auto 45px;
font-size: 20px;
line-height: 1.7;
color: var(--cooko-red)
}
.about-copy p {
margin: 0 0 30px
}
.mission-vision {
width: min(1040px, 90%);
margin: 65px auto 80px;
display: grid;
grid-template-columns: 1fr 1fr;
gap: 12%;
text-align: center
}
.mv-card img {
width: 112px;
height: 112px;

object-fit: contain
}
.mv-card h2 {
font-size: 23px;
margin: 18px 0 20px
}
.mv-card p {
font-size: 19px;
line-height: 1.5;
margin: 0
}
.programs-heading {
text-align: center;
font-size: 30px;
margin: 38px 0 40px
}
.course-section {
background: var(--cooko-red);
color: #fff;
padding: 48px max(calc((100% - 1080px)/2), 7%) 50px;
margin-bottom: 45px
}
.course-section.light {
background: #fff;
color: var(--cooko-red);
padding-top: 0
}
.course-photo {
display: block;
width: 100%;
height: 430px;
object-fit: cover;
border-radius: 30px;
margin: 0 auto 24px
}
.course-heading {
display: flex;

align-items: center;
gap: 22px;
margin: 0 0 12px
}
.course-level {
background: var(--cooko-cream);
color: var(--cooko-red);
border-radius: 4px;
padding: 5px 22px;
text-align: center;
min-width: 205px;
font-size: 13px
}
.course-heading h2 {
font-size: 25px;
margin: 0
}
.course-section p {
font-size: 17px;
line-height: 1.55;
margin: 0 0 24px
}
.course-section h3 {
font-size: 17px;
margin: 25px 0 12px
}
.course-section ul {
padding-left: 24px;
line-height: 1.55;
margin-bottom: 22px
}
.course-section .pill-button {
background: #fff;
color: var(--cooko-red);
min-width: 260px
}
.course-section.light .pill-button {

background: var(--cooko-red);
color: #fff
}
.gallery-intro {
width: min(900px, 86%);
margin: 40px auto 58px;
text-align: center;
font-size: 18px;
line-height: 1.55
}
.gallery-filters {
width: min(900px, 86%);
margin: 0 auto 28px;
display: flex;
gap: 7px
}
.gallery-filters button {
border: 0;
border-radius: 8px;
background: #ddd;
color: var(--cooko-red);
font-weight: 700;
padding: 8px 25px;
cursor: pointer
}
.gallery-filters button.active,
.gallery-filters button:hover {
background: var(--cooko-red);
color: #fff
}
.gallery-grid {
width: min(900px, 86%);
margin: 0 auto 60px;
display: grid;
grid-template-columns: repeat(2, 1fr);
gap: 24px 16px
}
.gallery-grid img {

width: 100%;
height: 240px;
object-fit: cover;
border-radius: 16px
}
.gallery-dots {
text-align: center;
color: var(--cooko-red);
font-size: 28px;
letter-spacing: 9px;
margin: 5px 0 35px
}
.contact-title {
text-align: center;
font-size: 38px;
margin: 58px 0 68px
}
.contact-layout {
width: min(1080px, 90%);
margin: 0 auto 65px;
display: grid;
grid-template-columns: 1.05fr .95fr;
gap: 8%;
align-items: start
}
.contact-form {
background: var(--cooko-red);
color: #fff;
border-radius: 18px;
padding: 30px 28px 38px
}
.contact-form h2 {
text-align: center;
font-size: 16px;
margin: 0 0 24px
}
.contact-form p {
font-size: 14px;

line-height: 1.5
}
.form-grid {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 18px 12px
}
.form-field {
display: flex;
flex-direction: column;
gap: 7px;
font-size: 13px
}
.form-field.full {
grid-column: 1/-1
}
.form-field input,
.form-field select,
.form-field textarea {
width: 100%;
border: 0;
background: #ddd;
padding: 10px;
color: #555;
font: inherit;
min-height: 37px
}
.form-field textarea {
height: 85px;
resize: vertical
}
.submit-wrap {
text-align: center;
margin-top: 28px
}
.submit-button {
background: transparent;

color: #fff;
border: 2px solid #fff;
border-radius: 5px;
padding: 8px 35px;
font-weight: 700;
cursor: pointer
}
.contact-details {
padding-top: 18px;
color: var(--cooko-red)
}
.detail-block {
margin-bottom: 32px
}
.detail-block h3 {
font-size: 20px;
margin: 0 0 7px
}
.detail-block p {
font-size: 18px;
line-height: 1.45;
margin: 0
}
.detail-social {
display: flex;
align-items: center;
gap: 12px;
margin: 8px 0;
font-size: 18px
}
.detail-social span {
font-size: 24px;
font-weight: 700
}
.notice {
font-size: 13px;
color: #fff;

margin-top: 12px;
text-align: center;
min-height: 18px
}
@media(max-width:900px) {
.site-header {
gap: 25px
}
.main-nav {
gap: 28px
}
.course-section {
padding-left: 6%;
padding-right: 6%
}
.contact-layout {
gap: 5%
}
.program-card img {
height: 190px
}
}
@media(max-width:640px) {
.site-header {
height: 62px;
padding: 0 5%;
gap: 15px
}
.brand {
width: 43px;
height: 54px
}
.menu-toggle {
display: block
}

.main-nav {
display: none;
position: absolute;
top: 62px;
left: 0;
right: 0;
background: var(--cooko-red);
padding: 8px 22px 18px;
flex-direction: column;
align-items: stretch;
gap: 0;
box-shadow: 0 8px 15px #0002
}
.main-nav.open {
display: flex
}
.main-nav a {
padding: 13px 4px;
border-bottom: 1px solid #ffffff30
}
.hero {
height: 340px
}
.hero h1 {
font-size: 29px
}
.hero p {
font-size: 17px
}
.section-title {
font-size: 25px;
margin: 38px 0 30px
}
.featured-grid {
grid-template-columns: 1fr;
gap: 22px;
width: 90%;

margin-bottom: 40px
}
.program-card img {
height: 220px
}
.benefits {
grid-template-columns: repeat(2, 1fr);
row-gap: 30px
}
.why-title {
font-size: 19px;
margin: 40px 0 28px
}
.page-hero {
height: 235px
}
.page-hero h1 {
font-size: 29px
}
.about-copy {
font-size: 16px;
line-height: 1.65;
margin: 28px auto
}
.mission-vision {
grid-template-columns: 1fr;
gap: 50px;
margin: 45px auto
}
.mv-card img {
width: 90px;
height: 90px
}
.mv-card p {
font-size: 16px

}
.programs-heading {
font-size: 26px;
margin: 30px 0
}
.course-section {
padding: 28px 6% 35px;
margin-bottom: 30px
}
.course-section.light {
padding-top: 0
}
.course-photo {
height: 260px;
border-radius: 22px
}
.course-heading {
gap: 10px;
flex-wrap: wrap
}
.course-level {
min-width: 125px;
padding: 5px 12px
}
.course-heading h2 {
font-size: 22px
}
.course-section p {
font-size: 15px
}
.course-section ul {
font-size: 14px
}
.gallery-intro {

font-size: 15px;
margin: 28px auto 35px
}
.gallery-grid {
gap: 12px;
width: 90%
}
.gallery-grid img {
height: 145px;
border-radius: 11px
}
.gallery-filters {
width: 90%;
gap: 5px
}
.gallery-filters button {
padding: 8px 17px
}
.contact-title {
font-size: 30px;
margin: 38px 0 35px
}
.contact-layout {
grid-template-columns: 1fr;
gap: 35px
}
.contact-form {
padding: 24px 18px 30px
}
.form-grid {
grid-template-columns: 1fr
}
.form-field.full {
grid-column: auto
}

.contact-details {
padding: 0 8px
}
.detail-block p,
.detail-social {
font-size: 16px
}
.site-footer {
padding: 30px 12px 25px
}
.footer-links {
gap: 20px
}
.footer-links a {
font-size: 12px
}
}
